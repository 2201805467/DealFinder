generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  BESTBUY
  WOOCOMMERCE
  SYNTHETIC
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
  CANCELLED
}

model Merchant {
  id                       String     @id @default(uuid()) @db.Uuid
  name                     String
  sourceType               SourceType @map("source_type")
  websiteUrl               String     @unique @map("website_url")
  enabled                  Boolean    @default(false)
  storageAuthorized        Boolean    @default(false) @map("storage_authorized")
  authorizationReference   String?    @map("authorization_reference")
  retentionSeconds         Int?       @map("retention_seconds")
  allowIndefiniteRetention Boolean    @default(false) @map("allow_indefinite_retention")
  isSynthetic              Boolean    @default(false) @map("is_synthetic")
  syncEnabled              Boolean    @default(false) @map("sync_enabled")
  syncIntervalSeconds      Int        @default(3600) @map("sync_interval_seconds")
  staleAfterSeconds        Int        @default(7200) @map("stale_after_seconds")
  nextSyncAt               DateTime?  @map("next_sync_at") @db.Timestamptz(3)
  offers                   Offer[]
  syncRuns                 SyncRun[]
  contentProducts          Product[]  @relation("ProductContent")

  @@index([sourceType, enabled])
  @@index([syncEnabled, nextSyncAt])
  @@map("merchants")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  slug        String     @unique
  parentId    String?    @map("parent_id") @db.Uuid
  isSynthetic Boolean    @default(false) @map("is_synthetic")
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  categoryId        String?   @map("category_id") @db.Uuid
  imageUrl          String?   @map("image_url")
  contentMerchantId String    @map("content_merchant_id") @db.Uuid
  contentExternalId String    @map("content_external_id")
  isSynthetic       Boolean   @default(false) @map("is_synthetic")
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contentMerchant   Merchant  @relation("ProductContent", fields: [contentMerchantId], references: [id], onDelete: Restrict)
  offers            Offer[]

  @@index([categoryId, createdAt])
  @@index([expiresAt])
  @@index([contentMerchantId])
  @@map("products")
}

model Offer {
  id                    String       @id @default(uuid()) @db.Uuid
  productId             String       @map("product_id") @db.Uuid
  merchantId            String       @map("merchant_id") @db.Uuid
  externalProductId     String       @map("external_product_id")
  variantKey            String       @default("") @map("variant_key")
  market                String       @default("")
  currency              String       @default("") @db.VarChar(3)
  currentPrice          Decimal?     @map("current_price") @db.Decimal(24, 6)
  referencePrice        Decimal?     @map("reference_price") @db.Decimal(24, 6)
  discountPercentage    Decimal?     @map("discount_percentage") @db.Decimal(7, 4)
  productUrl            String?      @map("product_url")
  affiliateUrl          String?      @map("affiliate_url")
  availability          Availability @default(UNKNOWN)
  isSynthetic           Boolean      @default(false) @map("is_synthetic")
  referencePriceTrusted Boolean      @default(false) @map("reference_price_trusted")
  shippingCost          Decimal?     @map("shipping_cost") @db.Decimal(24, 6)
  staleAt               DateTime?    @map("stale_at") @db.Timestamptz(3)
  lastUpdatedAt         DateTime     @map("last_updated_at") @db.Timestamptz(3)
  expiresAt             DateTime?    @map("expires_at") @db.Timestamptz(3)
  product               Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant              Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([merchantId, externalProductId, market, variantKey, currency], name: "sourceIdentity")
  @@index([productId])
  @@index([currency, currentPrice])
  @@index([market, merchantId])
  @@index([discountPercentage, lastUpdatedAt])
  @@index([lastUpdatedAt])
  @@index([staleAt])
  @@index([expiresAt])
  @@map("offers")
}

model SyncRun {
  id             String     @id @default(uuid()) @db.Uuid
  merchantId     String     @map("merchant_id") @db.Uuid
  sourceType     SourceType @map("source_type")
  startedAt      DateTime   @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?  @map("finished_at") @db.Timestamptz(3)
  processedCount Int        @default(0) @map("processed_count")
  status         SyncStatus @default(RUNNING)
  errorCode      String?    @map("error_code")
  errorDetails   String?    @map("error_details")
  scope          String     @default("BATCH")
  pageCount      Int        @default(0) @map("page_count")
  requestCount   Int        @default(0) @map("request_count")
  skippedCount   Int        @default(0) @map("skipped_count")
  durationMs     Int?       @map("duration_ms")
  merchant       Merchant   @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([merchantId, startedAt])
  @@map("sync_runs")
}
