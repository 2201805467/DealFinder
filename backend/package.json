{
  "name": "dealfinder-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:check": "tsx src/database/check.ts",
    "bestbuy:sample": "tsx src/scripts/bestbuy-sample.ts",
    "woocommerce:sample": "tsx src/scripts/woocommerce-sample.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:purge-expired": "tsx src/scripts/purge-expired.ts",
    "test:integration": "tsx src/scripts/test-database.ts",
    "worker": "tsx src/scripts/worker.ts",
    "worker:once": "tsx src/scripts/worker.ts --once",
    "worker:seed-demo": "tsx src/scripts/seed-worker.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "prisma": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
