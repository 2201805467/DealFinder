NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Per-process, per-IP limit over 60 seconds. Trust proxy remains disabled.
API_RATE_LIMIT_MAX=300
# Comma-separated exact HTTP(S) origins. Empty disables browser cross-origin access.
CORS_ORIGINS=http://localhost:5173
# Local development placeholders only. Replace both occurrences consistently.
POSTGRES_USER=dealfinder
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=dealfinder
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dealfinder:replace_with_local_password@127.0.0.1:5432/dealfinder
# Optional separate Prisma CLI principal; runtime does not use this variable.
# MIGRATION_DATABASE_URL=postgresql://migration_login:replace_me@db.example/dealfinder?sslmode=verify-full

# Obtain and activate your own key at https://developer.bestbuy.com/
BESTBUY_API_KEY=
BESTBUY_TIMEOUT_MS=10000

# No external store is authorized yet. local-test permits loopback hosts only.
WOOCOMMERCE_BASE_URL=http://127.0.0.1:8088
WOOCOMMERCE_STORE_NAME=DealFinder LOCAL TEST Store
WOOCOMMERCE_USAGE=local-test
WOOCOMMERCE_TIMEOUT_MS=10000

# Worker never starts with Express. Synthetic synchronization is forbidden in production.
WORKER_ENABLED=false
WORKER_ALLOW_SYNTHETIC=false
WORKER_POLL_MS=5000
WORKER_CLEANUP_MS=60000
WORKER_REQUEST_TIMEOUT_MS=10000
WORKER_MAX_RUN_MS=60000
WORKER_MAX_PAGES=10
WORKER_MAX_PRODUCTS=200
WORKER_MAX_REQUESTS=20
WORKER_PAGE_SIZE=20
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_MS=500
WORKER_MAX_BACKOFF_MS=30000
# Optional JSON overrides for the documented scoring weights, totaling 100.
DEAL_SCORING_RULES=
